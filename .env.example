# Express Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# Embedding Configuration (Pinned to 384 dimensions)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# LLM Provider Configuration
# Supported options: 'gemini', 'openai', 'groq'
LLM_PROVIDER=gemini

# API Key for chosen LLM provider (or use GEMINI_API_KEY / OPENAI_API_KEY / GROQ_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ChromaDB Vector Database Connection URL
CHROMA_URL=http://localhost:8000
